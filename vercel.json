{
  "rewrites": [
    {
      "source": "/api/books",
      "destination": "https://gutendex.com/books/"
    },
    {
      "source": "/api/books/:path*",
      "destination": "https://gutendex.com/books/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
